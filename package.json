{
  "name": "@thunder03/expressapidoc",
  "version": "0.1.3",
  "description": "FastAPI-style auto-generated API docs for Express, powered by Zod",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "express",
    "openapi",
    "swagger",
    "zod",
    "docs",
    "fastapi"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "zod": ">=3.23.0 <4"
  },
  "dependencies": {
    "supertest": "^7.3.0",
    "swagger-ui-express": "^5.0.0",
    "tsc": "^2.0.4",
    "typescript": "^7.0.2",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "vitest": "^5.0.2"
  }
}
